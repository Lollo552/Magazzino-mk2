{%- if predictive_search.performed -%}
  <div class="predictive">
    {%- if predictive_search.resources.products.size > 0 -%}
      <ul class="predictive__list" role="list">
        {%- for product in predictive_search.resources.products limit: 6 -%}
          <li>
            <a href="{{ product.url }}" class="predictive__item">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
              <span>
                <span class="predictive__title">{{ product.title | escape }}</span>
                <span class="muted">{{ product.price | money }}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="muted predictive__empty">{{ 'templates.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
    <a class="link-arrow predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last">
      {{ 'general.search.see_all' | t: terms: predictive_search.terms }} {% render 'icon', name: 'arrow-right' %}
    </a>
  </div>
{%- endif -%}
