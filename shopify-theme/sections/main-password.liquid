<section class="password page-width page-width--narrow">
  <h1 class="page-title">{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}
    <p class="password__message">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'newsletter-form' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status">{{ 'general.password_page.success' | t }}</p>
    {%- else -%}
      <div class="newsletter-form__row">
        <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordNewsletter" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
        <button type="submit" class="button">{{ 'general.password_page.notify' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <details class="password__login">
    <summary class="link-button">{{ 'general.password_page.login_link' | t }}</summary>
    {%- form 'storefront_password', class: 'form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="Password">{{ 'general.password_page.password' | t }}</label>
        <input type="password" id="Password" name="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="button">{{ 'general.password_page.enter' | t }}</button>
    {%- endform -%}
    <p class="muted">{{ 'general.password_page.admin_link_html' | t }}</p>
  </details>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
