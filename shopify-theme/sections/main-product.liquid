{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}
<section class="section page-width product" data-product-section data-section-id="{{ section.id }}">
  <div class="product__gallery" data-gallery>
    <div class="product__main-media">
      {%- if featured_media -%}
        {%- if featured_media.media_type == 'image' -%}
          {{ featured_media | image_url: width: 1600 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '540, 720, 1000, 1300, 1600',
            sizes: '(min-width: 990px) 55vw, 100vw',
            class: 'product__image',
            alt: featured_media.alt | default: product.title
          }}
        {%- else -%}
          {{ featured_media | media_tag: image_size: '1600x' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder product__image' }}
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 -%}
      <ul class="product__thumbs" role="list">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <li>
              <button type="button" class="product__thumb{% if media.id == featured_media.id %} is-active{% endif %}" data-thumb data-src="{{ media | image_url: width: 1600 }}" data-srcset="{{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1600 }} 1600w" data-alt="{{ media.alt | default: product.title | escape }}" data-media-id="{{ media.id }}" aria-label="{{ 'products.product.view_image' | t: index: forloop.index }}">
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
        {%- when 'vendor' -%}
          <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>
        {%- when 'title' -%}
          <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
        {%- when 'price' -%}
          <div class="product__price" {{ block.shopify_attributes }} data-price-wrapper>
            {% render 'price', product: product, use_variant: true %}
            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
              <p class="product__tax">
                {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif -%}
                {%- if shop.shipping_policy.body != blank -%} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
              </p>
            {%- endif -%}
          </div>
        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- endif -%}
        {%- when 'collapsible' -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary class="accordion__summary">{{ block.settings.heading | escape }} {% render 'icon', name: 'chevron-down' %}</summary>
            <div class="accordion__content rte">
              {{ block.settings.content }}
              {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
            </div>
          </details>
        {%- when 'buy_buttons' -%}
          <div class="product__form" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: 'ProductForm', class: 'product-form', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  <fieldset class="variant-picker" data-option-index="{{ forloop.index0 }}">
                    <legend class="variant-picker__label">{{ option.name | escape }}: <span data-selected-value>{{ option.selected_value | escape }}</span></legend>
                    <div class="variant-picker__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                        <input type="radio" id="{{ input_id }}" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option>
                        <label for="{{ input_id }}" class="pill">{{ value | escape }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              {%- endunless -%}

              {%- if block.settings.show_quantity -%}
                <div class="quantity-wrapper">
                  <label class="variant-picker__label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                  <div class="quantity" data-quantity>
                    <button type="button" class="quantity__btn" data-qty-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                    <input id="Quantity-{{ section.id }}" class="quantity__input" type="number" name="quantity" min="1" value="1" inputmode="numeric">
                    <button type="button" class="quantity__btn" data-qty-plus aria-label="{{ 'products.product.quantity_increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                  </div>
                </div>
              {%- endif -%}

              <div class="product-form__buttons">
                <button type="submit" name="add" class="button button--full" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                  {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              </div>
              <p class="form-message form-message--error" role="alert" hidden data-form-error></p>
            {%- endform -%}
          </div>
        {%- when 'share' -%}
          <div class="product__share" {{ block.shopify_attributes }}>
            <button type="button" class="link-button" data-share data-url="{{ request.origin }}{{ product.url }}" data-title="{{ product.title | escape }}">{{ 'products.product.share' | t }}</button>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | money | json }},
            "compare_at_price": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id }}, "src": {{ variant.featured_media | image_url: width: 1600 | json }} }{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "section-main-product",
  "settings": [],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "t:sections.main_product.blocks.vendor.name", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    {
      "type": "buy_buttons", "name": "t:sections.main_product.blocks.buy_buttons.name", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "t:sections.main_product.blocks.buy_buttons.settings.show_quantity.label", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label", "default": true }
      ]
    },
    { "type": "description", "name": "t:sections.main_product.blocks.description.name", "limit": 1 },
    {
      "type": "collapsible", "name": "t:sections.main_product.blocks.collapsible.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Spedizione e resi" },
        { "type": "richtext", "id": "content", "label": "t:general.text" },
        { "type": "page", "id": "page", "label": "t:sections.main_product.blocks.collapsible.settings.page.label" }
      ]
    },
    { "type": "share", "name": "t:sections.main_product.blocks.share.name", "limit": 1 }
  ]
}
{% endschema %}
