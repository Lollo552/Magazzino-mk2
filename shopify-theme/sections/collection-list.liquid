<section class="section page-width" style="--columns-desktop: {{ section.settings.columns_desktop }};">
  {%- if section.settings.heading != blank -%}
    <div class="section__header"><h2 class="section__title">{{ section.settings.heading | escape }}</h2></div>
  {%- endif -%}
  <ul class="grid grid--collections" role="list">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <li class="grid__item" {{ block.shopify_attributes }}>
        <a class="collection-card" href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.collections_url }}{% endif %}">
          <div class="collection-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, 50vw', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <span class="collection-card__title">
            {%- if collection != blank -%}{{ collection.title | escape }}{%- else -%}{{ 'onboarding.collection_title' | t }}{%- endif -%}
            {% render 'icon', name: 'arrow-right' %}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Categorie" },
    { "type": "range", "id": "columns_desktop", "label": "t:general.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 3 }
  ],
  "blocks": [
    { "type": "collection", "name": "t:sections.collection_list.blocks.collection.name", "settings": [ { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.settings.collection.label" } ] }
  ],
  "presets": [ { "name": "t:sections.collection_list.name", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] } ]
}
{% endschema %}
