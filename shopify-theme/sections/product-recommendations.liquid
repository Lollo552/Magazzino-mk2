<section class="section page-width" style="--columns-desktop: {{ section.settings.products_to_show }};" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section__header"><h2 class="section__title">{{ section.settings.heading | escape }}</h2></div>
    <ul class="grid grid--products" role="list">
      {%- for rec in recommendations.products -%}
        <li class="grid__item">{% render 'product-card', product: rec %}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "class": "section-product-recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Potrebbe piacerti anche" },
    { "type": "range", "id": "products_to_show", "label": "t:sections.featured_collection.settings.products_to_show.label", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
