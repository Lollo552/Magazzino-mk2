<section class="section newsletter-section">
  <div class="page-width newsletter-section__inner">
    {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'customer', id: 'NewsletterSection', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form__row">
          <label class="visually-hidden" for="NewsletterSectionEmail">{{ 'newsletter.label' | t }}</label>
          <input id="NewsletterSectionEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}">
          <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Resta aggiornato" },
    { "type": "richtext", "id": "text", "label": "t:general.text", "default": "<p>Iscriviti per ricevere novità e offerte riservate.</p>" }
  ],
  "presets": [ { "name": "t:sections.newsletter.name" } ]
}
{% endschema %}
