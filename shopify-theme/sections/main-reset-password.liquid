<section class="section page-width page-width--narrow account-form">
  <h1 class="page-title">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="muted">{{ 'customer.reset_password.subtext' | t }}</p>
  {%- form 'reset_customer_password', class: 'form' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field">
      <label for="ResetPassword">{{ 'customer.login_page.password' | t }}</label>
      <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="button">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{ "name": "t:sections.customers.reset_password", "settings": [] }
{% endschema %}
