<section class="section page-width page-width--narrow account">
  <a href="{{ routes.account_url }}" class="link-button">&larr; {{ 'customer.account.return' | t }}</a>
  <h1 class="page-title">{{ 'customer.addresses.title' | t }}</h1>

  <details class="accordion">
    <summary class="button">{{ 'customer.addresses.add_new' | t }}</summary>
    <div class="accordion__content">
      {%- form 'customer_address', customer.new_address, class: 'form' -%}
        {% render 'address-fields', form: form, id: 'new' %}
        <button type="submit" class="button">{{ 'customer.addresses.add' | t }}</button>
      {%- endform -%}
    </div>
  </details>

  {%- paginate customer.addresses by 10 -%}
    <ul class="address-list" role="list">
      {%- for address in customer.addresses -%}
        <li class="address-card">
          {%- if address == customer.default_address -%}<p class="badge">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
          {{ address | format_address }}
          <details class="accordion">
            <summary class="link-button">{{ 'customer.addresses.edit' | t }}</summary>
            <div class="accordion__content">
              {%- form 'customer_address', address, class: 'form' -%}
                {% render 'address-fields', form: form, id: address.id %}
                <button type="submit" class="button">{{ 'customer.addresses.update' | t }}</button>
              {%- endform -%}
            </div>
          </details>
          <form method="post" action="{{ address.url }}" data-confirm="{{ 'customer.addresses.delete_confirm' | t }}">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="link-button">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "t:sections.customers.addresses", "settings": [] }
{% endschema %}
