<section class="section page-width page-width--narrow empty-state empty-state--page">
  <p class="eyebrow">404</p>
  <h1 class="page-title">{{ 'templates.404.title' | t }}</h1>
  <p>{{ 'templates.404.subtext' | t }}</p>
  <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'templates.cart.continue_shopping' | t }}</a>
