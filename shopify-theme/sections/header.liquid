<header class="header{% if section.settings.sticky %} header--sticky{% endif %}" data-header>
  <div class="page-width header__inner">
    <button class="header__icon header__menu-toggle" type="button" aria-controls="MobileNav" aria-expanded="false" data-menu-toggle>
      {% render 'icon', name: 'menu' %}
      <span class="visually-hidden">{{ 'sections.header.menu' | t }}</span>
    </button>

    {%- if request.page_type == 'index' -%}<h1 class="header__heading">{%- else -%}<div class="header__heading">{%- endif -%}
      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if section.settings.logo != blank -%}
          {%- liquid
            assign logo_width_2x = section.settings.logo_width | times: 2
            assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round
          -%}
          {{ section.settings.logo | image_url: width: logo_width_2x | image_tag:
            width: section.settings.logo_width,
            height: logo_height,
            alt: section.settings.logo.alt | default: shop.name,
            loading: 'eager'
          }}
        {%- else -%}
          <span class="header__shop-name">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    {%- if request.page_type == 'index' -%}</h1>{%- else -%}</div>{%- endif -%}

    <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="nav" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="nav__item{% if link.links != blank %} nav__item--has-children{% endif %}">
            {%- if link.links != blank -%}
              <details class="nav__dropdown">
                <summary class="nav__link{% if link.child_active %} is-active{% endif %}">
                  {{ link.title | escape }} {% render 'icon', name: 'chevron-down' %}
                </summary>
                <ul class="nav__submenu" role="list">
                  {%- for child in link.links -%}
                    <li><a class="nav__sublink" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__icons">
      <details class="header__search" data-search>
        <summary class="header__icon" aria-label="{{ 'general.search.search' | t }}">{% render 'icon', name: 'search' %}</summary>
        <div class="header__search-panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
            <label class="visually-hidden" for="HeaderSearch">{{ 'general.search.search' | t }}</label>
            <input id="HeaderSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" data-predictive-input>
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="button button--small">{{ 'general.search.submit' | t }}</button>
          </form>
          <div class="predictive-results" data-predictive-results></div>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header__icon">
          {% render 'icon', name: 'account' %}
          <span class="visually-hidden">{% if customer %}{{ 'customer.account.title' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}</span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__cart" id="HeaderCart">
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">{{ 'templates.cart.title' | t }}</span>
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="mobile-nav" id="MobileNav" hidden data-mobile-nav>
    <ul class="mobile-nav__list" role="list">
      {%- for link in section.settings.menu.links -%}
        <li>
          <a href="{{ link.url }}" class="mobile-nav__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- if link.links != blank -%}
            <ul class="mobile-nav__sub" role="list">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}" class="mobile-nav__sublink">{{ child.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</header>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {%- if section.settings.logo -%}
      "logo": {{ section.settings.logo | image_url: width: 500 | prepend: 'https:' | json }},
    {%- endif -%}
    "url": {{ request.origin | append: routes.root_url | json }}
  }
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:sections.header.settings.logo.label" },
    { "type": "range", "id": "logo_width", "label": "t:sections.header.settings.logo_width.label", "min": 50, "max": 300, "step": 10, "unit": "px", "default": 120 },
    { "type": "link_list", "id": "menu", "label": "t:sections.header.settings.menu.label", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "t:sections.header.settings.sticky.label", "default": true }
  ]
}
{% endschema %}
