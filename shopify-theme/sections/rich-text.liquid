<section class="section page-width rich-text rich-text--{{ section.settings.alignment }}">
  <div class="rich-text__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="section__title" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <a href="{{ block.settings.link | default: routes.root_url }}" class="button" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "class": "section-rich-text",
  "settings": [
    { "type": "select", "id": "alignment", "label": "t:general.alignment", "options": [ { "value": "left", "label": "t:general.left" }, { "value": "center", "label": "t:general.center" } ], "default": "center" }
  ],
  "blocks": [
    { "type": "heading", "name": "t:general.heading", "settings": [ { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Parliamo di te" } ] },
    { "type": "text", "name": "t:general.text", "settings": [ { "type": "richtext", "id": "text", "label": "t:general.text", "default": "<p>Usa questa sezione per presentare il negozio o un messaggio importante.</p>" } ] },
    { "type": "button", "name": "t:sections.rich_text.blocks.button.name", "settings": [ { "type": "text", "id": "label", "label": "t:sections.hero.blocks.buttons.settings.label_1.label", "default": "Contattaci" }, { "type": "url", "id": "link", "label": "t:general.link" } ] }
  ],
  "presets": [ { "name": "t:sections.rich_text.name", "blocks": [ { "type": "heading" }, { "type": "text" } ] } ]
}
{% endschema %}
