{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="section page-width" style="--columns-desktop: {{ section.settings.columns_desktop }};">
  <div class="section__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.show_view_all and collection != blank and collection.products_count > limit -%}
      <a href="{{ collection.url }}" class="link-arrow">{{ 'sections.featured_collection.view_all' | t }} {% render 'icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.description != blank -%}
    <div class="section__description rte">{{ section.settings.description }}</div>
  {%- endif -%}

  <ul class="grid grid--products" role="list">
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <li class="grid__item">{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <li class="grid__item">{% render 'product-card' %}</li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "In evidenza" },
    { "type": "richtext", "id": "description", "label": "t:general.text" },
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.settings.collection.label" },
    { "type": "range", "id": "products_to_show", "label": "t:sections.featured_collection.settings.products_to_show.label", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "t:general.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "t:sections.featured_collection.settings.show_view_all.label", "default": true }
  ],
  "presets": [ { "name": "t:sections.featured_collection.name" } ]
}
{% endschema %}
