<section class="section page-width page-width--narrow account-form">
  <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', novalidate: 'novalidate', class: 'form' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="form__row">
      <div class="field">
        <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
      </div>
      <div class="field">
        <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
      </div>
    </div>
    <div class="field">
      <label for="RegisterEmail">{{ 'customer.login_page.email' | t }}</label>
      <input type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" value="{{ form.email }}" required>
    </div>
    <div class="field">
      <label for="RegisterPassword">{{ 'customer.login_page.password' | t }}</label>
      <input type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <label class="checkbox">
      <input type="checkbox" name="customer[accepts_marketing]" value="true">
      {{ 'customer.register.accepts_marketing' | t }}
    </label>
    <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
    <p class="muted"><a href="{{ routes.account_login_url }}">{{ 'customer.register.have_account' | t }}</a></p>
  {%- endform -%}
</section>

{% schema %}
{ "name": "t:sections.customers.register", "settings": [] }
{% endschema %}
