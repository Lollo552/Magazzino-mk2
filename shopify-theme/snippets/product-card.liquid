{%- comment -%}
  Product card used in grids.
  Accepts:
  - product: {Object} product (optional; renders a placeholder when blank)
  - lazy: {Boolean} lazy-load the image (default true)
{%- endcomment -%}
{%- liquid
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
-%}
{%- if product != blank -%}
  <article class="card">
    <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 900 | image_tag:
          loading: loading,
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
          widths: '240, 360, 540, 720, 900',
          class: 'card__image',
          alt: product.featured_media.alt | default: product.title
        }}
        {%- if settings.card_show_secondary_image and product.media[1] != blank -%}
          {{ product.media[1] | image_url: width: 900 | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            widths: '240, 360, 540, 720, 900',
            class: 'card__image card__image--secondary',
            alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder card__image' }}
      {%- endif -%}
      {%- if product.available == false -%}
        <span class="badge badge--muted">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
      {%- endif -%}
    </a>
    <div class="card__info">
      {%- if settings.card_show_vendor -%}
        <p class="card__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h3 class="card__title"><a href="{{ product.url }}" class="link-cover">{{ product.title }}</a></h3>
      {% render 'price', product: product %}
    </div>
  </article>
{%- else -%}
  <article class="card card--placeholder">
    <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder card__image' }}</div>
    <div class="card__info">
      <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="price"><span class="price__current">{{ 1999 | money }}</span></div>
    </div>
  </article>
{%- endif -%}
