{%- layout none -%}
{%- assign gift_card_balance = gift_card.balance | money -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card_balance, shop: shop.name }}</title>
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="section page-width page-width--narrow gift-card">
      <h1 class="page-title">{{ shop.name }}</h1>
      <p class="gift-card__value">{{ gift_card.initial_value | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="badge badge--muted">{{ 'gift_cards.issued.expired' | t }}</p>
      {%- endif -%}
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="muted">{{ 'gift_cards.issued.remaining' | t }} {{ gift_card.balance | money }}</p>
      {%- endif -%}
      {%- if gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: '%d/%m/%Y' -%}
        <p class="muted">{{ 'gift_cards.issued.expires_on' | t: expires_on: expires_on }}</p>
      {%- endif -%}
      <div class="gift-card__code">
        <input type="text" class="gift-card__code-input" value="{{ gift_card.code | format_code }}" aria-label="{{ 'gift_cards.issued.code' | t }}" readonly onclick="this.select()">
      </div>
      <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <p class="muted">{{ 'gift_cards.issued.how_to_use' | t }}</p>
      <div class="gift-card__buttons">
        <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print()">{{ 'gift_cards.issued.print' | t }}</button>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="button button--secondary">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a>
        {%- endif -%}
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) {
          new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
        }
      });
    </script>
  </body>
</html>
